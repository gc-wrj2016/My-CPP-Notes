#include<bits/stdc++.h>
#define int long long
using namespace std;
const int N=5e3+5,M=1e4+5;
int sum[N][N],a[N][N],n,m;
signed main()
{
    cin>>n>>m;
    for(int i=1;i<=n;i++)
    {
        int x,y,v;
        cin>>x>>y>>v;
        x++,y++;
        a[x][y]+=v;
    }
    for(int i=1;i<N;i++)
    {
        for(int j=1;j<N;j++)
        {
            sum[i][j]=sum[i-1][j]+sum[i][j-1]-sum[i-1][j-1]+a[i][j];
        }
    }
    if(m>=N-4)
    {
        cout<<a[N-4][N-4];
        return 0;
    }
    int mx=0;
    for(int i=m;i<N;i++)
    {
        for(int j=m;j<N;j++)
        {
            mx=max(mx,sum[i][j]-sum[i-m][j]-sum[i][j-m]+sum[i-m][j-m]);
        }
    }
    cout<<mx;
	return 0;
}