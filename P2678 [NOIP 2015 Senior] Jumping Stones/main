#include <bits/stdc++.h>
using namespace std;
const int N = 5e4 + 5;
int d[N],l,n,m;
bool check(int x)
{
    int cnt=0;
    if(l<x)return false;
    int last=0;
    for(int i=1;i<=n;i++)
    {
        if(d[i]-last<x)cnt++;
        else last=d[i];
    }
    return cnt<=m;
}
signed main()
{
    cin>>l>>n>>m;
    for(int i=1;i<=n;i++)
    {
        cin>>d[i];
    }
    int l=0,r=1e9+5;
    while(l+1<r)
    {
        int mid=(l+r)>>1;
        if(check(mid))
        {
            l=mid;
        }
        else r=mid;
    }
    if(check(l))cout<<l;
    else cout<<r;
    return 0;
}