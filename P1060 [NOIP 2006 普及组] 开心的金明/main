#include<bits/stdc++.h>
using namespace std;
const int N=25,M=3e4+5;
int w[N],c[N],dp[M];
signed main()
{
	int m,n;
	cin>>m>>n;
	for(int i=1;i<=n;i++)
	{
		cin>>w[i]>>c[i];
		c[i]*=w[i];
	}
	for(int i=1;i<=n;i++)
	{
		for(int j=m;j>=w[i];j--)
		{
			dp[j]=max(dp[j],dp[j-w[i]]+c[i]);
		}
	}
	cout<<dp[m];
	return 0;
}