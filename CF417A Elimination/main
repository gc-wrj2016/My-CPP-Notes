#include<bits/stdc++.h>
using namespace std;
const int N=5,M=1e4+5;
int w[N],c[N],dp[M];
signed main()
{
	cin>>w[1]>>w[2];
	int n,m;
	cin>>n>>m;
	int p=m*n;
	m*=w[1];
	int k;
	cin>>k;
	c[1]=n,c[2]=1;
	p-=k;
	if(p<=0)
	{
		cout<<0;
		return 0;
	}
	for(int i=1;i<=2;i++)
	{
		for(int j=w[i];j<=m;j++)
		{
			dp[j]=max(dp[j],dp[j-w[i]]+c[i]);
		}
	}
	for(int i=1;i<=m;i++)
	{
		if(dp[i]>=p)
		{
			cout<<i;
			return 0;
		}
	}
	cout<<m;
	return 0;
}