#include<bits/stdc++.h>
#define int long long
using namespace std;
const int N=5e3+5,M=1e4+5;
int n;
priority_queue<int,vector<int>,greater<int>>q;
signed main()
{
    cin>>n;
    for(int i=1;i<=n;i++)
    {
        int x;
        cin>>x;
        q.push(x);
    }
    int ans=0;
    while(q.size()>1)
    {
        int x,y;
        x=q.top(),q.pop(),y=q.top(),q.pop();
        q.push(x+y);
        ans+=x+y;
    }
    cout<<ans;
	return 0;
}