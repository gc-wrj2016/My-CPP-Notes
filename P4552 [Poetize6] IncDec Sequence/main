#include<bits/stdc++.h>
#define int long long
using namespace std;
const int N=1e5+5;
int n,a[N],d[N];
signed main()
{
    cin>>n;
    for(int i=1;i<=n;i++)
    {
        cin>>a[i];
        d[i]=a[i]-a[i-1];
    }
    int x=0,y=0;
    for(int i=2;i<=n;i++)
    {
        if(d[i]>0) x+=d[i];
        else y+=-d[i];
    }
    cout<<max(x,y)<<endl;
    cout<<abs(a[1]-a[n])+1<<endl;
	return 0;
}